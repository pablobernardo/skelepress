{
  "chapters": [
    "<CASES>/chapters/chapter-2.md",
    "<CASES>/chapters/chapter-10.md"
  ],
  "config": {
    "base_dir": "<CASES>",
    "path": "<CASE>"
  },
  "env": {
    "PANDOC_EMOJI_BALLOT_ICONS": "1",
    "PANDOC_EMOJI_DIR": "<CASES>/output/emoji",
    "PANDOC_MERMAID_BACKGROUND": "transparent",
    "PANDOC_MERMAID_BACKGROUND_EXPLICIT": "1",
    "PANDOC_MERMAID_OUTPUT_DIR": "<CASES>/output/mermaid"
  },
  "pandoc": {
    "argv": [
      "pandoc",
      "<CASES>/output/report-recorded.md",
      "-s",
      "--section-divs",
      "--template=<REPO>/templates/reader.html",
      "--embed-resources",
      "--lua-filter=<REPO>/filters/lazy-images.lua",
      "--lua-filter=<REPO>/filters/inline-code-breaks.lua",
      "--lua-filter=<REPO>/filters/heading-page-break.lua",
      "--resource-path=<CASES>/chapters:<CASES>",
      "--metadata",
      "title=Conformance",
      "--metadata",
      "lang=en",
      "-o",
      "<CASES>/output/report-recorded.html"
    ],
    "cwd": null,
    "target": {
      "html": "<CASES>/output/report-recorded.html",
      "markdown": "<CASES>/output/report-recorded.md"
    }
  },
  "plan_version": 1,
  "side_effects": {
    "clearpage_between_h1": false,
    "emoji": {
      "dir": "<CASES>/output/emoji",
      "enabled": false,
      "missing_svg": "<CASES>/output/emoji/_missing.svg",
      "prepare_argv": null
    },
    "heading_break_level": 1,
    "html": {
      "reader": true,
      "template_note": false
    },
    "keep_merged_markdown": true,
    "mermaid": {
      "background": "transparent",
      "dir": "<CASES>/output/mermaid",
      "enabled": false
    }
  },
  "toolkit": {
    "root": "<REPO>",
    "version": "<VERSION>"
  }
}
